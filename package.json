{
  "name": "tsubasa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.js",
  "bin": {
    "tsubasa": "./dist/cli/index.js"
  },
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "dev:electron": "npm run build:web && npm run build:server && npm run build:electron && electron .",
    "dev": "tsx watch src/server/index.ts",
    "tsubasa": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:cli": "tsc -p tsconfig.cli.json",
    "build:electron": "tsc -p tsconfig.electron.json && tsc -p tsconfig.electron.preload.json && node -e \"import('node:fs').then(fs => fs.renameSync('dist/electron/preload.js', 'dist/electron/preload.cjs'))\"",
    "build": "npm run typecheck && npm run build:web && npm run build:server",
    "package:win": "npm run typecheck && npm run build:web && npm run build:server && npm run build:electron && npm run build:cli && node scripts/package-win.mjs",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@stylexjs/stylex": "^0.19.1",
    "@tanstack/react-virtual": "^3.14.26",
    "better-sqlite3": "^13.2.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.40.0",
    "googleapis": "^189.0.0",
    "hono": "^4.7.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.30.4",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "unplugin-stylex": "^0.6.3",
    "vite": "^6.1.0"
  }
}
